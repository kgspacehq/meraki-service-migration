// =============================================================================
// measures.dax: Meraki Service Migration & Release Readiness (Power BI)
// Simulated project. Meraki Industries and all data are fictional.
// Not affiliated with Cisco Meraki.
//
// Definitions match data/README.md and the queries in /sql.
// The file has three parts. See powerbi/BUILD-GUIDE.md for where each one goes.
//   PART A  Calculated tables   -> Modeling > New table (one at a time)
//   PART B  Calculated columns  -> select the table > Table tools > New column
//   PART C  Measures            -> DAX query view: paste the whole DEFINE block,
//                                  then click "Update model: Add new measures".
//                                  The '_Measures' table must exist first.
//                                  Format strings are in each measure's comment.
// =============================================================================


// =============================================================================
// PART A: CALCULATED TABLES
// =============================================================================

// A1. Date table. Covers the service history (Oct 2023) through decommissioning
//     (Jan 2027). Mark it as a date table on [Date].
Date =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2023, 10, 1 ), DATE ( 2027, 1, 31 ) ),
    "Year", YEAR ( [Date] ),
    "Quarter", "Q" & QUARTER ( [Date] ) & " " & YEAR ( [Date] ),
    "Month Number", MONTH ( [Date] ),
    "Month", FORMAT ( [Date], "mmm yyyy" ),
    "Year Month", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),     // sort key for [Month]
    "Week Start", [Date] - WEEKDAY ( [Date], 2 ) + 1,           // Monday
    "Weekday", FORMAT ( [Date], "ddd" ),
    "Is Weekend", WEEKDAY ( [Date], 2 ) > 5
)

// A2. Discrepancy types for the "Discrepancies by type" visual. This table is
//     disconnected (no relationships). [Sort] is the sort order of [Type].
Discrepancy Type =
DATATABLE (
    "Type", STRING,
    "Sort", INTEGER,
    {
        { "Missing record", 1 },
        { "Status mismatch", 2 },
        { "Missing dates", 3 },
        { "Duplicate load", 4 }
    }
)


// =============================================================================
// PART B: CALCULATED COLUMNS
// =============================================================================

// B1. legacy_tickets[Is Open]: TRUE for tickets that are still open in the legacy system.
Is Open =
legacy_tickets[status] IN { "Open", "In Progress", "On Hold" }

// B2. legacy_tickets[Recon Status]: the reconciliation result for each legacy ticket.
//     Same rule as sql/01_reconciliation.sql Q4. A ticket is "Reconciled" when at
//     least one migrated record has the same status, a created_date, and a
//     closed_date if it is Closed or Cancelled. Otherwise it is classified as
//     Missing, Status mismatch or Missing dates. Waves with no migration load
//     are "Not migrated".
//     TREATAS links the tables without a relationship, so the model stays simple.
Recon Status =
VAR _id = legacy_tickets[ticket_id]
VAR _status = legacy_tickets[status]
VAR _wave = RELATED ( depots[wave] )
VAR _migratedWaves = DISTINCT ( migrated_tickets[wave] )
VAR _rows =
    CALCULATETABLE (
        migrated_tickets,
        TREATAS ( { _id }, migrated_tickets[legacy_ticket_id] )
    )
VAR _matches =
    COUNTROWS (
        FILTER (
            _rows,
            migrated_tickets[status] = _status
                && NOT ISBLANK ( migrated_tickets[created_date] )
                && (
                    NOT ( migrated_tickets[status] IN { "Closed", "Cancelled" } )
                        || NOT ISBLANK ( migrated_tickets[closed_date] )
                )
        )
    )
VAR _mismatches =
    COUNTROWS ( FILTER ( _rows, migrated_tickets[status] <> _status ) )
RETURN
    SWITCH (
        TRUE (),
        NOT ( _wave IN _migratedWaves ), "Not migrated",
        ISEMPTY ( _rows ), "Missing",
        _matches > 0, "Reconciled",
        _mismatches > 0, "Status mismatch",
        "Missing dates"
    )

// B3. readiness_criteria[Target Label]: readable target, e.g. ">= 95.0%", "<= 0 count", "= Yes".
Target Label =
readiness_criteria[comparator] & " "
    & SWITCH (
        readiness_criteria[unit],
        "%", FORMAT ( readiness_criteria[threshold], "0.0" ) & "%",
        "flag", IF ( readiness_criteria[threshold] = 1, "Yes", "No" ),
        FORMAT ( readiness_criteria[threshold], "0.##" ) & " " & readiness_criteria[unit]
    )

// B4. readiness_criteria[Actual Label]: readable actual value. Blank means "Not measured".
Actual Label =
IF (
    ISBLANK ( readiness_criteria[actual_value] ),
    "Not measured",
    SWITCH (
        readiness_criteria[unit],
        "%", FORMAT ( readiness_criteria[actual_value], "0.0" ) & "%",
        "flag", IF ( readiness_criteria[actual_value] = 1, "Yes", "No" ),
        FORMAT ( readiness_criteria[actual_value], "0.##" ) & " " & readiness_criteria[unit]
    )
)


// =============================================================================
// PART C: MEASURES (paste this whole block into DAX query view)
// =============================================================================

DEFINE

    // ---------------------------------------------------------------- Parameters
    // Snapshot date of the dataset (data/README.md).            Format: Short date
    MEASURE '_Measures'[As Of Date] = DATE ( 2026, 11, 13 )
    // Report subtitle, e.g. "Snapshot as of Nov 13, 2026".       Format: Text
    MEASURE '_Measures'[Snapshot Label] =
        "Snapshot as of " & FORMAT ( [As Of Date], "mmm d, yyyy" )
    // Go/no-go targets from docs/01-charter.md.                   Format: 0.0%
    MEASURE '_Measures'[UAT Target] = 0.95
    MEASURE '_Measures'[SIT Target] = 0.95
    MEASURE '_Measures'[Reconciliation Target] = 0.995
    // Minimum weighted readiness score for GO.                    Format: 0.0
    MEASURE '_Measures'[Readiness Score Target] = 90

    // ---------------------------------------------------------------- Colors (theme)
    MEASURE '_Measures'[Color GO] = "#2E9E5B"
    MEASURE '_Measures'[Color NO-GO] = "#D64541"
    MEASURE '_Measures'[Color Warning] = "#F2A900"
    MEASURE '_Measures'[Color Neutral] = "#9AA5B4"

    // ---------------------------------------------------------------- Testing
    // pass rate = Passed / (Passed + Failed). Blocked and Not Run are not executed.
    MEASURE '_Measures'[Test Cases] = COUNTROWS ( test_cases )                        // #,0
    MEASURE '_Measures'[Tests Passed] =
        CALCULATE ( [Test Cases], test_cases[status] = "Passed" )                      // #,0
    MEASURE '_Measures'[Tests Failed] =
        CALCULATE ( [Test Cases], test_cases[status] = "Failed" )                      // #,0
    MEASURE '_Measures'[Tests Blocked] =
        CALCULATE ( [Test Cases], test_cases[status] = "Blocked" )                     // #,0
    MEASURE '_Measures'[Tests Not Run] =
        CALCULATE ( [Test Cases], test_cases[status] = "Not Run" )                     // #,0
    MEASURE '_Measures'[Tests Executed] = [Tests Passed] + [Tests Failed]              // #,0
    // Pass Rate in the current filter context. BLANK when nothing has been executed.
    MEASURE '_Measures'[Pass Rate] = DIVIDE ( [Tests Passed], [Tests Executed] )       // 0.0%
    MEASURE '_Measures'[Execution %] = DIVIDE ( [Tests Executed], [Test Cases] )       // 0.0%
    MEASURE '_Measures'[UAT Pass Rate] =
        CALCULATE ( [Pass Rate], test_cases[test_type] = "UAT" )                       // 0.0%
    MEASURE '_Measures'[SIT Pass Rate] =
        CALCULATE ( [Pass Rate], test_cases[test_type] = "SIT" )                       // 0.0%
    // Gate C01: "MET", "NOT MET", or "NOT STARTED" when no UAT case has been executed.
    MEASURE '_Measures'[UAT Gate Status] =
        VAR _rate = [UAT Pass Rate]
        RETURN
            IF ( ISBLANK ( _rate ), "NOT STARTED", IF ( _rate >= [UAT Target], "MET", "NOT MET" ) )
    // Field-value color for UAT visuals.
    MEASURE '_Measures'[UAT Pass Rate Color] =
        SWITCH (
            [UAT Gate Status],
            "MET", [Color GO],
            "NOT MET", [Color NO-GO],
            [Color Neutral]
        )

    // ---------------------------------------------------------------- Defects
    // Open defect = status other than Closed or Deferred (data/README.md).
    MEASURE '_Measures'[Defects] = COUNTROWS ( defects )                               // #,0
    MEASURE '_Measures'[Open Defects] =
        CALCULATE ( [Defects], NOT ( defects[status] IN { "Closed", "Deferred" } ) )   // #,0
    // +0 so that waves with no open defects show 0 instead of blank.
    MEASURE '_Measures'[Open S1 Defects] =
        CALCULATE ( [Open Defects], defects[severity] = "S1" ) + 0                     // #,0
    MEASURE '_Measures'[Open S2 Defects] =
        CALCULATE ( [Open Defects], defects[severity] = "S2" ) + 0                     // #,0
    // Critical = S1 + S2 (gates C03 and C04).
    MEASURE '_Measures'[Open Critical Defects] = [Open S1 Defects] + [Open S2 Defects] // #,0
    // Age of open defects in days at the snapshot date (sql/04_defect_aging.sql).
    MEASURE '_Measures'[Avg Open Defect Age (days)] =
        AVERAGEX (
            FILTER ( defects, NOT ( defects[status] IN { "Closed", "Deferred" } ) ),
            DATEDIFF ( defects[opened_date], [As Of Date], DAY )
        )                                                                              // 0.0
    MEASURE '_Measures'[Max Open Defect Age (days)] =
        MAXX (
            FILTER ( defects, NOT ( defects[status] IN { "Closed", "Deferred" } ) ),
            DATEDIFF ( defects[opened_date], [As Of Date], DAY )
        )                                                                              // 0
    MEASURE '_Measures'[S1 Color] =
        IF ( [Open S1 Defects] > 0, [Color NO-GO], [Color GO] )

    // ---------------------------------------------------------------- Migration & reconciliation
    // Uses legacy_tickets[Recon Status] (Part B2).
    MEASURE '_Measures'[Legacy Tickets] = COUNTROWS ( legacy_tickets )                 // #,0
    // Legacy tickets in waves that already have a migration load (Waves 1-3).
    MEASURE '_Measures'[Legacy Tickets In Scope] =
        CALCULATE ( [Legacy Tickets], legacy_tickets[Recon Status] <> "Not migrated" ) // #,0
    MEASURE '_Measures'[Migrated Rows] = COUNTROWS ( migrated_tickets )                // #,0
    MEASURE '_Measures'[Migrated Tickets] =
        DISTINCTCOUNT ( migrated_tickets[legacy_ticket_id] )                           // #,0
    // Extra rows from duplicate loads (sql/02_data_quality.sql Q3).
    MEASURE '_Measures'[Duplicate Rows] = [Migrated Rows] - [Migrated Tickets]         // #,0
    MEASURE '_Measures'[Reconciled Tickets] =
        CALCULATE ( [Legacy Tickets], legacy_tickets[Recon Status] = "Reconciled" )    // #,0
    // Gate C05: reconciled / legacy tickets in scope. BLANK for waves not migrated.
    MEASURE '_Measures'[Reconciliation %] =
        DIVIDE ( [Reconciled Tickets], [Legacy Tickets In Scope] )                     // 0.0%
    MEASURE '_Measures'[Discrepancies] = [Legacy Tickets In Scope] - [Reconciled Tickets] // #,0
    MEASURE '_Measures'[Missing Tickets] =
        CALCULATE ( [Legacy Tickets], legacy_tickets[Recon Status] = "Missing" )       // #,0
    MEASURE '_Measures'[Status Mismatches] =
        CALCULATE ( [Legacy Tickets], legacy_tickets[Recon Status] = "Status mismatch" ) // #,0
    MEASURE '_Measures'[Missing Dates] =
        CALCULATE ( [Legacy Tickets], legacy_tickets[Recon Status] = "Missing dates" ) // #,0
    // Gate C06: open legacy tickets with no migrated record. 0 for migrated waves,
    // BLANK for waves not migrated yet.
    MEASURE '_Measures'[Open Tickets Lost] =
        VAR _lost =
            CALCULATE ( [Missing Tickets], legacy_tickets[Is Open] = TRUE () )
        RETURN
            IF ( [Legacy Tickets In Scope] > 0, _lost + 0 )                            // #,0
    MEASURE '_Measures'[Reconciliation Gate Status] =
        VAR _rate = [Reconciliation %]
        RETURN
            IF ( ISBLANK ( _rate ), "NOT MIGRATED", IF ( _rate >= [Reconciliation Target], "MET", "NOT MET" ) )
    MEASURE '_Measures'[Reconciliation Color] =
        SWITCH (
            [Reconciliation Gate Status],
            "MET", [Color GO],
            "NOT MET", [Color NO-GO],
            [Color Neutral]
        )
    MEASURE '_Measures'[Open Tickets Lost Color] =
        IF ( [Open Tickets Lost] > 0, [Color NO-GO], [Color GO] )
    // Value for the "Discrepancies by type" visual (rows from 'Discrepancy Type').
    MEASURE '_Measures'[Discrepancy Count] =
        SWITCH (
            SELECTEDVALUE ( 'Discrepancy Type'[Type] ),
            "Missing record", [Missing Tickets],
            "Status mismatch", [Status Mismatches],
            "Missing dates", [Missing Dates],
            "Duplicate load", [Duplicate Rows]
        )                                                                              // #,0

    // ---------------------------------------------------------------- Readiness (go/no-go)
    // Weighted score = SUM(weight x score) / SUM(weight) (sql/05_readiness_score.sql).
    MEASURE '_Measures'[Readiness Score] =
        DIVIDE (
            SUMX ( readiness_criteria, readiness_criteria[weight] * readiness_criteria[score] ),
            SUM ( readiness_criteria[weight] )
        )                                                                              // 0.0
    MEASURE '_Measures'[Criteria Total] = COUNTROWS ( readiness_criteria )            // 0
    MEASURE '_Measures'[Criteria Met] =
        CALCULATE ( COUNTROWS ( readiness_criteria ), readiness_criteria[met] = "Y" ) + 0 // 0
    // Gate criteria (gate = "Y") that are not met. Any value above 0 forces NO-GO.
    MEASURE '_Measures'[Gates Failed] =
        CALCULATE (
            COUNTROWS ( readiness_criteria ),
            readiness_criteria[gate] = "Y",
            readiness_criteria[met] = "N"
        ) + 0                                                                          // 0
    // GO only if every gate is met AND the weighted score is >= 90. Needs one wave in context.
    MEASURE '_Measures'[Go/No-Go] =
        IF (
            HASONEVALUE ( 'Wave'[wave] ),
            IF ( [Gates Failed] = 0 && [Readiness Score] >= [Readiness Score Target], "GO", "NO-GO" )
        )
    MEASURE '_Measures'[Go/No-Go Color] =
        SWITCH ( [Go/No-Go], "GO", [Color GO], "NO-GO", [Color NO-GO] )
    // Points each criterion costs the weighted score: weight x (100 - score) / 100.
    MEASURE '_Measures'[Points Lost] =
        SUMX (
            readiness_criteria,
            readiness_criteria[weight] * ( 100 - readiness_criteria[score] ) / 100
        )                                                                              // 0.0
    // Status of a single criterion row: "MET" or "NOT MET".
    MEASURE '_Measures'[Gate Status] =
        SWITCH ( SELECTEDVALUE ( readiness_criteria[met] ), "Y", "MET", "N", "NOT MET" )
    MEASURE '_Measures'[Gate Status Color] =
        SWITCH ( [Gate Status], "MET", [Color GO], "NOT MET", [Color NO-GO] )
    // Phase of the wave: Live (has an actual cutover date), In UAT (UAT cases
    // executed), otherwise In configuration.
    MEASURE '_Measures'[Wave Phase] =
        IF (
            HASONEVALUE ( 'Wave'[wave] ),
            SWITCH (
                TRUE (),
                NOT ISBLANK ( MAX ( depots[actual_cutover_date] ) ), "Live",
                CALCULATE ( [Tests Executed], test_cases[test_type] = "UAT" ) > 0, "In UAT",
                "In configuration"
            )
        )
    MEASURE '_Measures'[Wave Phase Color] =
        SWITCH ( [Wave Phase], "Live", [Color GO], "In UAT", [Color Warning], [Color Neutral] )

// Required by DAX query view. Shows the key numbers per wave as a check.
EVALUATE
SUMMARIZECOLUMNS (
    'Wave'[wave],
    "Readiness Score", [Readiness Score],
    "Go/No-Go", [Go/No-Go],
    "UAT Pass Rate", [UAT Pass Rate],
    "Open S1", [Open S1 Defects],
    "Reconciliation %", [Reconciliation %],
    "Open Tickets Lost", [Open Tickets Lost]
)
ORDER BY 'Wave'[wave]
